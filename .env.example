# ===== CẤU HÌNH PG FOOD – chép file này thành .env.local (máy tính) hoặc nhập vào Vercel > Settings > Environment Variables

# Địa chỉ website chính thức (dùng cho SEO, sitemap). Ví dụ: https://pgfood.vn
NEXT_PUBLIC_SITE_URL=

# --- NƠI NHẬN ĐƠN ---
# "google-sheets" (ghi vào Google Sheet) hoặc "console" (chỉ ghi log, để thử nghiệm)
ORDER_DESTINATION=google-sheets
# Link Web App của Google Apps Script (xem HUONG-DAN-GOOGLE-SHEET.md)
GOOGLE_SCRIPT_URL=
# Mật khẩu – phải giống biến SECRET trong Code.gs
GOOGLE_SCRIPT_SECRET=

# --- BÁO ĐƠN QUA TELEGRAM ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- BÁO ĐƠN QUA EMAIL (Resend.com) ---
EMAIL_ENABLED=false
RESEND_API_KEY=
# Nhiều email cách nhau dấu phẩy
NOTIFY_EMAIL_TO=
# Người gửi (cần xác minh tên miền trên Resend). Để trống dùng onboarding@resend.dev
EMAIL_FROM=
